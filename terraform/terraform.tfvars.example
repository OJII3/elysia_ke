proxmox_url          = "http://<host>:8006/api2/json"
proxmox_user         = "root@pam"
proxmox_password     = "<password>"
proxmox_vm_template  = "ubuntu-22.04-cloudinit-template"

# Storage that has Snippets content enabled (usually 'local')
proxmox_snippets_storage = "local"

# Enable snippet upload by SSHing into the Proxmox host
proxmox_ssh_host             = "pve.local"
proxmox_ssh_user             = "root"
proxmox_ssh_private_key_path = "~/.ssh/id_ed25519"
